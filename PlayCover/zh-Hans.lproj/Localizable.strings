"settings.toggle.forceQuitAppOnClose" = "关闭应用时强制退出进程";
"settings.toggle.forceQuitAppOnClose.help" = "可解决应用残留在后台运行的问题";
"settings.toggle.unrealEngineSetScaleFactor" = "修改虚幻引擎的分辨率缩放";
"settings.toggle.unrealEngineSetScaleFactor.help" = "虚幻引擎通常会为不同机型预先配置不同的分辨率缩放比例。启用该选项后，将会强制虚幻引擎使用PlayCover图像设置中配置的分辨率缩放比例";
"settings.toggle.fixWeirdWindowFocusState" = "修复异常的窗口激活状态";
"settings.toggle.fixWeirdWindowFocusState.help" = "可解决从其他应用切换回当前应用后，窗口标题栏依然维持灰色未激活状态的问题";
"settings.toggle.enhanceBuiltinMouse" = "修复虚幻引擎内置的鼠标操作支持";
"settings.toggle.enhanceBuiltinMouse.help" = "一些虚幻引擎游戏自带支持鼠标操作，但没有正确处理鼠标指针的显示与隐藏。启用该选项后，将会修复鼠标指针的隐藏操作，从而正常使用内置的鼠标操作";
"settings.toggle.preventKeyboardBeepSound" = "消除键盘按键产生的嘟嘟声";
"settings.toggle.fixPlayChainMatchLimit" = "修复PlayChain未正确处理MatchLimit的问题";
"settings.toggle.fixPlayChainMatchLimit.help" = "可解决某些应用的谷歌帐号登录状态无法保留的问题";
"settings.toggle.unityEngineFixKeyboardInput" = "修复Unity内置的键盘操作支持";
"settings.toggle.unityEngineFixKeyboardInput.help" = "一些Unity游戏通过旧版的Input.GetKeyDown()接口来捕获键盘输入，已知此方法在iOS平台上存在键位卡顿、延迟等问题。启用该选项后，将会修复这些键盘操作问题";
"settings.toggle.disableINTLUtilsSwizzling" = "禁用INTLUtils Swizzling";
"settings.toggle.disableINTLUtilsSwizzling.help" = "可解决启动后无响应的问题";
"settings.toggle.unityEngineForceLandscape" = "强制Unity以横屏模式显示";
"settings.toggle.unityEngineForceLandscape.help" = "可解决Unity游戏画面的屏幕方向错误的问题";
"settings.toggle.unrealEngineSmartTextInput" = "修复虚幻引擎集成键盘的打字问题";
"settings.toggle.unrealEngineSmartTextInput.help" = "虚幻引擎使用集成键盘时，不需要经由一个弹窗界面来输入文本，而是直接在游戏画面中输入文本。启用该选项后，可解决集成键盘与按键映射的冲突问题（还需要打开智能按键映射选项）";
"settings.toggle.webViewSmartTextInput" = "修复网页界面的打字问题";
"settings.toggle.webViewSmartTextInput.help" = "可解决网页界面文本输入框与按键映射的冲突问题（还需要打开智能按键映射选项）";
"settings.toggle.unityEngineIgnoreKeyboardDelegateCrash" = "忽略Unity KeyboardDelegate闪退";
"settings.toggle.unityEngineIgnoreKeyboardDelegateCrash.help" = "一些Unity游戏启动时会出现KeyboardDelegate断言失败闪退的情况，这个断言失败并不一定会影响游戏运行，可以忽略";
"settings.toggle.preloadAppTrackingFramework" = "预加载AppTrackingTransparency.framework";
"settings.toggle.preloadAppTrackingFramework.help" = "可解决一些应用在查询App跟踪状态时无限卡住的问题";
"settings.toggle.skipGameCenterLogin" = "跳过Game Center登录步骤";
"settings.toggle.skipGameCenterLogin.help" = "模拟用户取消登录Game Center的操作，已知可修复某些应用在等待Game Center登录结果时卡住的问题";
"settings.toggle.unityEngineDisableOrientationCheck" = "禁用Unity屏幕方向检查";
"settings.toggle.unityEngineDisableOrientationCheck.help" = "如果“强制Unity以横屏模式显示”选项不能成功修复屏幕方向，请尝试同时启用该选项";
"settings.toggle.unityEngineDisableAROverlayTouches" = "禁用AR叠加层触摸事件";
"settings.toggle.unityEngineDisableAROverlayTouches.help" = "阻止AR叠加层捕获触摸事件，已知可修复某些应用进行多点触摸后按键映射失灵的问题";
"settings.toggle.forceWebViewUseMobileContentMode" = "强制WebView请求移动版网页";
"settings.toggle.forceWebViewUseMobileContentMode.help" = "WebView默认情况下会请求桌面版网页，启用此选项后会请求移动版网页";
"settings.toggle.unrealEngineBypassEntitlementsCheck" = "绕过虚幻引擎Entitlements检查";
"settings.toggle.unrealEngineBypassEntitlementsCheck.help" = "虚幻引擎会检查Entitlement以保证程序正常运行，启用此选项后可绕过这项检查，已知可修复某些虚幻引擎游戏启动时闪退的问题";
"settings.toggle.preventGoogleMeasurementWriteFiles" = "阻止Google Measurement写入文件";
"settings.toggle.preventGoogleMeasurementWriteFiles.help" = "清除Google Measurement文件，并将文件夹设置为只读状态，已知可修复某些应用登录时闪退的问题";
"settings.toggle.bypassUnknownDetection" = "绕过未知检测";
"settings.toggle.unrealEngineFixFilePath" = "修复虚幻引擎文件路径问题（需重装App）";
"settings.toggle.unrealEngineFixFilePath.help" = "修正虚幻引擎对于绝对路径的处理逻辑，已知可修复某些虚幻引擎游戏加载资源时报错、闪退、黑屏的问题";
"settings.toggle.fixAvailableMemoryValue" = "修正可用运行内存的查询结果（需重装App）";
"settings.toggle.fixAvailableMemoryValue.help" = "修正os_proc_available_memory函数，已知可修复某些游戏启动闪退、场景加载卡顿、渲染质量偏低的问题";
"settings.toggle.neoxEngineFixFilePath" = "修复NeoX引擎文件路径问题（需重装App）";
"settings.toggle.neoxEngineFixFilePath.help" = "修正NeoX引擎的文件路径，已知可修复NeoX引擎游戏启动闪退的问题";
"settings.toggle.disableCriWareSonicSync" = "禁用CRIWARE SonicSYNC（需重装App）";
"settings.toggle.disableCriWareSonicSync.help" = "禁用CRIWARE音频插件的SonicSYNC特性，已知可修复某些应用出现多线程死锁导致启动后无响应的问题";
"settings.toggle.enableAutoRotate" = "启用自动旋转屏幕方向";
"settings.toggle.enableAutoRotate.help" = "需要先在分辨率设置中选择“自由缩放”才能使用这个功能。当游戏内容发生屏幕方向变化时，PlayCover会自动调整窗口尺寸";
"settings.toggle.jinChanChanFixMicrophone" = "修复麦克风权限问题（需重装App）";
"settings.toggle.forceUIViewLandscape" = "强制部分UI界面以横屏模式显示";
"settings.toggle.useBuiltinPointerLock" = "使用应用内置的鼠标锁定控制";
"settings.toggle.useBuiltinPointerLock.help" = "PlayCover默认会拦截鼠标锁定操作。如果应用原生支持鼠标锁定控制，需要启用该选项才能正常工作";
"settings.toggle.clearLastTouchesWhenEnterTextInput" = "开始文本输入时清除上一次的触摸记录";
"settings.toggle.clearLastTouchesWhenEnterTextInput.help" = "可解决无法正常开始文本输入的问题";
"settings.toggle.disableAllAlertDialogs" = "屏蔽所有提示弹窗";
"settings.toggle.dontInterceptClicksInUIViews" = "部分UI界面禁止按键映射拦截鼠标点击";
"settings.toggle.unityEngineFixAutoRotate" = "修复自动旋转屏幕方向时出现的问题";
"settings.toggle.useNewHitTestMethodAlways" = "总是使用新的命中测试方法";
"settings.toggle.useNewHitTestMethodAlways.help" = "可解决一些UI界面点击没反应的问题";
"settings.toggle.fixFirstLaunchClickCrash" = "修复首次启动界面点击闪退的问题";
"settings.toggle.racingMasterFixFilePath" = "修复文件路径问题";
"settings.toggle.fortniteFixNonMainThreadCrash" = "修复在非主线程更新界面导致闪退的问题";

